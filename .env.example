NODE_ENV=development
PORT=8080
HOST=0.0.0.0
LOG_LEVEL=info
SERVICE_NAME=agent-tool-server-doc-rag
SERVICE_VERSION=0.2.0
GIT_SHA=unknown
PUBLIC_BASE_URL=

# Development only. Production rejects disabled authentication.
AUTH_MODE=disabled
# Comma-separated to support rotation. Each key must be hex encoding at least 32 random bytes,
# optionally behind a non-secret label such as `prod_`. Generate with: openssl rand -hex 32
API_KEYS=
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_MS=60000

# ---------------------------------------------------------------------------
# Corpus. One process serves exactly one corpus and one authorization boundary.
# Leave CORPUS_SOURCE unset to infer it, or set it explicitly:
#   filesystem  - index one local directory (VS Code / stdio / mounted volume)
#   azure-blob  - index one private container prefix using managed identity
#   none        - no corpus; the server starts but never reports ready
# ---------------------------------------------------------------------------
CORPUS_SOURCE=filesystem

# Filesystem corpus. Production requires an absolute, dedicated directory.
DOCS_ROOT=./docs
CORPUS_WATCH=true

# Azure Blob corpus. The deployment alone chooses the account, container and prefix.
# Managed identity only: connection strings, SAS tokens and account keys are rejected.
AZURE_STORAGE_ACCOUNT_NAME=
AZURE_STORAGE_CONTAINER=
AZURE_STORAGE_PREFIX=

# Bounded refresh. Zero disables background refresh entirely.
CORPUS_REFRESH_INTERVAL_MS=0

# Ingestion budgets. Requests can never raise these ceilings.
CORPUS_MAX_DEPTH=12
CORPUS_MAX_DIRECTORY_ENTRIES=2000
CORPUS_MAX_DOCUMENTS=2000
CORPUS_MAX_DOCUMENT_BYTES=1048576
CORPUS_MAX_TOTAL_BYTES=33554432
CORPUS_MAX_CONCURRENT_READS=4

# Index budgets and chunking.
INDEX_MAX_CHUNKS=20000
INDEX_MAX_TERMS=200000
INDEX_MAX_MEMORY_BYTES=134217728
INDEX_BUILD_TIMEOUT_MS=60000
CHUNK_MAX_CHARS=1600
CHUNK_MIN_CHARS=160
SECTION_MAX_CHARS=200

# Retrieval. Scores are a normalized 0..1 share of attainable evidence, never probabilities.
# bm25 is the default because it wins the committed evaluation; see npm run eval:retrieval.
SEARCH_ALGORITHM=bm25
SEARCH_MIN_SCORE=0.2
SEARCH_RELATIVE_CUTOFF=0.2
SEARCH_MAX_CANDIDATES=200
SEARCH_MAX_RESULTS=10
SEARCH_MAX_PER_SOURCE=3
SEARCH_MAX_CONTENT_CHARS=1600
SEARCH_MAX_TOTAL_CHARS=8000
SEARCH_TIMEOUT_MS=2000
SEARCH_MAX_CONCURRENT=4
SEARCH_QUEUE_LIMIT=32
